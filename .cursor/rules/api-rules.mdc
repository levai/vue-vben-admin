## API 函数定义规范

### 标准 API 函数结构

```typescript
// frontend/apps/web-antd/src/api/system/user.ts
import { requestClient } from '#/api/request';

// 1. 定义命名空间和类型
export namespace SystemUserApi {
  export interface SystemUser {
    id: string;
    username: string;
    realName?: string;
    status: 0 | 1;
    // ... 其他字段
  }
}

// 2. 定义 API 函数（使用 async function）
/**
 * 获取用户列表数据
 */
async function getUserList(params: Recordable<any>) {
  return requestClient.get<{
    list: SystemUserApi.SystemUser[];
    total: number;
  }>('/system/user', { params });
}

// 3. 导出函数
export { getUserList };
```

### HTTP 方法使用

```typescript
// GET 请求
async function getUserById(id: string) {
  return requestClient.get<SystemUserApi.SystemUser>(`/system/user/${id}`);
}

// POST 请求
async function createUser(data: Omit<SystemUserApi.SystemUser, 'id'>) {
  return requestClient.post('/system/user', data);
}

// PUT 请求
async function updateUser(id: string, data: Partial<SystemUserApi.SystemUser>) {
  return requestClient.put(`/system/user/${id}`, data);
}

// DELETE 请求
async function deleteUser(id: string) {
  return requestClient.delete(`/system/user/${id}`);
}
```

### 类型定义规范

**✅ 正确：使用命名空间导出类型**

```typescript
export namespace SystemUserApi {
  export interface SystemUser {
    id: string;
    username: string;
  }

  export interface CreateUserParams {
    username: string;
    password: string;
  }
}

async function createUser(data: SystemUserApi.CreateUserParams) {
  return requestClient.post('/system/user', data);
}
```

**❌ 错误：直接导出接口**

```typescript
// 不推荐：类型命名可能冲突
export interface User {
  id: string;
}
```

### 函数命名规范

- **获取列表**: `get{Resource}List` (例: `getUserList`)
- **获取详情**: `get{Resource}ById` (例: `getUserById`)
- **创建资源**: `create{Resource}` (例: `createUser`)
- **更新资源**: `update{Resource}` (例: `updateUser`)
- **删除资源**: `delete{Resource}` (例: `deleteUser`)
- **获取选项**: `get{Resource}Options` (例: `getUserOptions`)

